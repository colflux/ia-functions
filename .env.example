LLM_PROVIDER=groq
# Proveedores de respaldo, en orden, si el principal está saturado: el plan
# gratuito de Cerebras acepta unas 5 peticiones por minuto.
LLM_RESPALDO=

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=postgresql://colflux:colflux@db:5432/colflux_ia

RETRIEVAL_TOP_K=4

# Servidores MCP registrados ("nombre=url,nombre2=url2"). Vacío = el agente
# corre solo con RAG, sin tools de datos del backend.
MCP_SERVERS=colflux-backend=http://mcp-backend:8000/mcp

# URL del backend Django. La usan mcp_server/ (datos) y la subida de archivos
# (verificar la sesión y leer el modelo de datos). En local con
# docker-compose apunta a host.docker.internal:8000 (puerto por defecto de
# `backend/docker-compose.yml` en desarrollo). EN PRODUCCIÓN (servidor
# 44.213.47.34) el backend real corre en el puerto 8001, no 8000 — ajustar
# en el .env real del servidor: BACKEND_API_BASE_URL=http://host.docker.internal:8001
BACKEND_API_BASE_URL=http://host.docker.internal:8000

# Solo se usan en docker-compose.yml (puertos publicados en el host y credenciales de Postgres).
# EN PRODUCCIÓN (servidor 44.213.47.34): WEB_PORT=8001 colisiona con el
# backend real, que ya usa ese puerto ahí. Usar un puerto libre, p. ej.
# WEB_PORT=8003 (8000 y 8001 ya están tomados por los dos backends, 3000 por
# el frontend). docker-compose.yml ata este puerto a 127.0.0.1 — no hace
# falta abrirlo en el firewall de Lightsail, nginx lo enruta desde el
# puerto 80 (ver README.md, sección "Despliegue en producción").
WEB_PORT=8001
DB_PORT=5433
MCP_PORT=8002
POSTGRES_USER=colflux
POSTGRES_PASSWORD=colflux
POSTGRES_DB=colflux_ia

# Subida de archivos desde el chat (POST /documentos). Sin BUCKET_NAME la subida
# responde que no está disponible. La clave se crea en Lightsail → Storage →
# bucket → Permissions → Access keys.
BUCKET_NAME=
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Carpeta del bucket para este entorno. Vacío en producción; en el laboratorio,
# lab/ para no mezclar sus archivos con los de producción.
BUCKET_PREFIJO=
MAX_UPLOAD_MB=25

# Revisión de imágenes subidas: usa GEMINI_API_KEY (arriba) con este modelo.
# Sin GEMINI_API_KEY, las imágenes no se aceptan.
IMAGE_MODEL=gemini-3.5-flash-lite

# Wiki del proyecto como fuente del asistente. Se vuelve a leer cada
# WIKI_INTERVALO_HORAS (solo lo que cambió). Vacío = no se usa.
WIKI_URL=https://colflux.github.io/context/
WIKI_INTERVALO_HORAS=24
